IO_LOC "clk" P16;
IO_PORT "clk" PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

IO_LOC "rst" U4;
IO_PORT "rst" PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

// Dock LEDs (unconnected on bare SOM, kept for dock use)
IO_LOC "led[5]" N23;
IO_LOC "led[4]" N21;
IO_LOC "led[3]" M25;
IO_LOC "led[2]" L20;
IO_LOC "led[1]" R26;
IO_LOC "led[0]" J14;
IO_PORT "led[5]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[4]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[3]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[2]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[1]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[0]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Candidate debug-UART TX pins on the SOM (same stream on all three)
IO_LOC "uart_tx_p15" P15;
IO_PORT "uart_tx_p15" PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "uart_tx_u16" U16;
IO_PORT "uart_tx_u16" PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "uart_tx_v22" V22;
IO_PORT "uart_tx_v22" PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// Debug-UART RX pin on the SOM JST (verified by gw5a138_rxprobe: the
// 157-pin sticky mask bit for N16 goes low exactly on host TX traffic)
IO_LOC "uart_rx" N16;
IO_PORT "uart_rx" PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
