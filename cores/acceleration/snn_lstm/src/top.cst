IO_LOC "clk" E2;
IO_PORT "clk" PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

IO_LOC "rst_key" H11;
IO_PORT "rst_key" PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;

IO_LOC "led[0]" E8;
IO_PORT "led[0]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[1]" L6;
IO_PORT "led[1]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "uart_tx" C3;
IO_PORT "uart_tx" PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "uart_rx" B3;
IO_PORT "uart_rx" PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
