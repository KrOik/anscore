{
  "ip_name": "gw2a_cnn_lprnet_post_process",
  "core_module": "lprnet_post_process",
  "core_source": "src/lprnet_post_process.v",
  "description": "Spatial sum + argmax + CTC decode chain (LPRNet head).",
  "clock_reset": {
    "clk": "single clock",
    "rst_n": "active-low synchronous",
    "clk_en": "step enable; tie 1 for full rate"
  },
  "status_protocol": "streaming valid/new_line; no start/done/error",
  "parameters": [
    {
      "name": "PE_COL_NUM",
      "default": "2"
    },
    {
      "name": "CYCLE_PERIOD_OUT",
      "default": "2"
    },
    {
      "name": "IMG_COL",
      "default": "8"
    },
    {
      "name": "IMG_ROW",
      "default": "6"
    },
    {
      "name": "DATA_WIDTH",
      "default": "8"
    },
    {
      "name": "ACC_WIDTH",
      "default": "16"
    },
    {
      "name": "CONV_POSITIVE",
      "default": "1"
    },
    {
      "name": "BLANK_CHAR",
      "default": "3"
    },
    {
      "name": "VALID_CHAR_NUM",
      "default": "4"
    },
    {
      "name": "OCHW",
      "default": "$clog2(CYCLE_PERIOD_OUT*PE_COL_NUM)",
      "note": "char index width"
    }
  ],
  "ports": [
    {
      "name": "new_line_input_1",
      "dir": "input",
      "width": "1",
      "signed": false,
      "packed_dims": null,
      "note": "pulse before each row"
    },
    {
      "name": "data_input_valid",
      "dir": "input",
      "width": "1",
      "signed": false,
      "packed_dims": null,
      "note": "data beat valid"
    },
    {
      "name": "data_input",
      "dir": "input",
      "width": "PE_COL_NUM*DATA_WIDTH",
      "signed": true,
      "packed_dims": [
        "PE_COL_NUM"
      ],
      "note": "signed samples"
    },
    {
      "name": "out_char",
      "dir": "output",
      "width": "OCHW",
      "signed": false,
      "packed_dims": null,
      "note": "decoded channel index"
    },
    {
      "name": "out_valid",
      "dir": "output",
      "width": "1",
      "signed": false,
      "packed_dims": null,
      "note": "decoded char valid"
    },
    {
      "name": "frame_start_out",
      "dir": "output",
      "width": "1",
      "signed": false,
      "packed_dims": null,
      "note": "1 beat before out_valid"
    }
  ],
  "validation": {
    "selftest_units": "15 (CTC)",
    "golden_digest": "ED74208A",
    "sim": "iverilog PASS (full / mask A / mask B)",
    "board": {
      "board": "Sipeed Tang Primer 20K",
      "device": "GW2A-LV18PG256C8/I7",
      "bitstream_mask": "mff00",
      "uart": "115200@COM24",
      "evidence": "doc/board_uart_mff00.txt"
    }
  }
}