IO_LOC "clk" H11;
IO_LOC "uart_tx" M11;
IO_LOC "dbg_uart" A11;
IO_LOC "dbg_pass" B11;
IO_LOC "dbg_fail" N6;
IO_LOC "dbg_hb" D11;

IO_PORT "clk" IO_TYPE=LVCMOS33;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "dbg_uart" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_pass" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_fail" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_hb" IO_TYPE=LVCMOS33 DRIVE=8;
