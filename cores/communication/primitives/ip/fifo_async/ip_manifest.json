{
  "ip_name": "gw2a_comm_fifo_async",
  "core_module": "fifo_async",
  "core_source": "src/fifo_async.v",
  "wrapper_source": "ip/fifo_async/gw2a_comm_fifo_async.v",
  "description": "Dual-clock FIFO, depth 2**AW: Gray-coded pointers, 2-FF pointer synchronizers both directions, registered dout (valid one rd_clk after rd_en).",
  "clock_reset": {
    "wr_clk": "write clock domain",
    "wr_rst_n": "active-low async reset, write domain",
    "rd_clk": "read clock domain (use a real clock resource: PLL output on the global net; a fabric FF->BUFG clock was dead on GW2A-18C hardware)",
    "rd_rst_n": "active-low async reset, read domain"
  },
  "status_protocol": "wr side: wr_en accepted when !full; rd side: rd_en pops when !empty, dout updates one rd_clk later",
  "parameters": [
    { "name": "DW", "default": "8", "note": "data width" },
    { "name": "AW", "default": "4", "note": "address width; depth = 2**AW" }
  ],
  "ports": [
    { "name": "wr_clk",   "dir": "input",  "width": "1",  "signed": false, "note": "write clock" },
    { "name": "wr_rst_n", "dir": "input",  "width": "1",  "signed": false, "note": "write-domain reset" },
    { "name": "wr_en",    "dir": "input",  "width": "1",  "signed": false, "note": "write strobe" },
    { "name": "din",      "dir": "input",  "width": "DW", "signed": false, "note": "write data" },
    { "name": "full",     "dir": "output", "width": "1",  "signed": false, "note": "write side full" },
    { "name": "rd_clk",   "dir": "input",  "width": "1",  "signed": false, "note": "read clock" },
    { "name": "rd_rst_n", "dir": "input",  "width": "1",  "signed": false, "note": "read-domain reset" },
    { "name": "rd_en",    "dir": "input",  "width": "1",  "signed": false, "note": "read strobe" },
    { "name": "dout",     "dir": "output", "width": "DW", "signed": false, "note": "read data (1 rd_clk after rd_en)" },
    { "name": "empty",    "dir": "output", "width": "1",  "signed": false, "note": "read side empty" }
  ],
  "validation": {
    "selftest_unit": "4 (FIFO): clk -> 13.5 MHz rPLL crossing, 40B stream + full flag",
    "golden_digest": "B5FC9B84",
    "golden_source": "tools/golden_model.py (independent Python model, no RTL output)",
    "sim": "iverilog PASS (masks 001F, 000F, 0001, 000E, 0000); read stream identical to sim/golden_fifo.txt",
    "board": {
      "board": "Sipeed Tang Primer 20K",
      "device": "GW2A-LV18PG256C8/I7",
      "uart": "115200 COMM5 report on pin M11",
      "evidence": "doc/board_uart_*.txt"
    },
    "standalone_synth": {
      "LUT_class": 18,
      "ALU": 10,
      "DFF": 46,
      "BSRAM": "2 x RAM16SDP4 (distributed)",
      "DSP": 0
    }
  }
}
