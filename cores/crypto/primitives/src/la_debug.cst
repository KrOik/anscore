IO_LOC "clk" H11;
IO_LOC "uart_tx" M11;
IO_LOC "dbg_uart" A11;
IO_LOC "dbg_done" B11;
IO_LOC "dbg_pass" N6;
IO_LOC "dbg_fail" D11;
IO_LOC "dbg_ce" N9;
IO_LOC "dbg_rstn" N7;
IO_LOC "dbg_busy" L9;
IO_LOC "dbg_hb" N8;

IO_PORT "clk" IO_TYPE=LVCMOS33;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "dbg_uart" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_done" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_pass" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_fail" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_ce" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_rstn" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_busy" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg_hb" IO_TYPE=LVCMOS33 DRIVE=8;
