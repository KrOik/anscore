        {
          "line": 1,
          "text": "// Project F Library - Division (Integer)"
        },
        {
          "line": 2,
          "text": "// (C)2021 Will Green, Open source hardware released under the MIT License"
        },
        {
          "line": 3,
          "text": "// Learn more at https://projectf.io"
        },
        {
          "line": 9,
          "text": "    input wire logic clk,"
        },
        {
          "line": 10,
          "text": "    input wire logic start,          // start signal"
        },
        {
          "line": 11,
          "text": "    output     logic busy,           // calculation in progress"
        },
        {
          "line": 12,
          "text": "    output     logic valid,          // quotient and remainder are valid"
        },
        {
          "line": 13,
          "text": "    output     logic dbz,            // divide by zero flag"
        },
        {
          "line": 15,
          "text": "    input wire logic [WIDTH-1:0] y,  // divisor"
        },
        {
          "line": 16,
          "text": "    output     logic [WIDTH-1:0] q,  // quotient"
        },
        {
          "line": 17,
          "text": "    output     logic [WIDTH-1:0] r   // remainder"
        },
        {
          "line": 20,
          "text": "    logic [WIDTH-1:0] y1;            // copy of divisor"
        },
        {
          "line": 21,
          "text": "    logic [WIDTH-1:0] q1, q1_next;   // intermediate quotient"
        },
        {
          "line": 22,
          "text": "    logic [WIDTH:0] ac, ac_next;     // accumulator (1 bit wider)"
        },
        {
          "line": 34,
          "text": "    always_ff @(posedge clk) begin"
        },
        {
          "line": 35,
          "text": "        if (start) begin"
        },
        {
          "line": 36,
          "text": "            valid <= 0;"
        },
        {
          "line": 38,
          "text": "            if (y == 0) begin  // catch divide by zero"
        },
        {
          "line": 39,
          "text": "                busy <= 0;"
        },
        {
          "line": 40,
          "text": "                dbz <= 1;"
        },
        {
          "line": 41,
          "text": "            end else begin  // initialize values"
        },
        {
          "line": 42,
          "text": "                busy <= 1;"
        },
        {
          "line": 43,
          "text": "                dbz <= 0;"
        },
        {
          "line": 46,
          "text": "            end"
        },
        {
          "line": 47,
          "text": "        end else if (busy) begin"
        },
        {
          "line": 48,
          "text": "            if (i == WIDTH-1) begin  // we're done"
        },
        {
          "line": 49,
          "text": "                busy <= 0;"
        },
        {
          "line": 50,
          "text": "                valid <= 1;"
        }
      ],
